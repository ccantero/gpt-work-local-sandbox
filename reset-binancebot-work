#!/bin/bash
set -euo pipefail
umask 077
export PATH=/usr/bin:/bin
for variable in ${!PG@}; do unset "$variable"; done
export PGCONNECT_TIMEOUT=5

if (( $# != 0 )); then
    echo "Usage: $0" >&2
    exit 64
fi

readonly PG_BIN="/usr/lib/postgresql/17/bin"
readonly PG_SOCKET="/var/run/postgresql"
readonly PG_PORT="5432"
readonly BASELINE="binancebot_work_baseline"
readonly WORK_DB="binancebot_work"
readonly WORK_OWNER="local-gpt-work"

if [[ $(/usr/bin/id -un) != postgres ]]; then
    echo "ERROR: reset must run as the postgres OS user" >&2
    exit 69
fi

connection=(-h "$PG_SOCKET" -p "$PG_PORT" -U postgres -w)
admin() {
    "$PG_BIN/psql" -X "${connection[@]}" -d postgres -v ON_ERROR_STOP=1 -At "$@"
}

data_dir=$(admin -c "SHOW data_directory")
[[ -d $data_dir ]] || exit 69
exec 8>"$data_dir/.binancebot-reset.lock"
if ! flock -n 8; then
    echo "ERROR: another Work reset is running" >&2
    exit 75
fi

safe=$(admin -c "
    SELECT d.datdba = 'postgres'::regrole AND d.datconnlimit = 0
       AND NOT has_database_privilege('$WORK_OWNER', d.oid, 'CONNECT')
       AND NOT has_database_privilege('$WORK_OWNER', d.oid, 'CREATE')
       AND NOT EXISTS (SELECT FROM pg_database w WHERE w.datname='$WORK_DB'
                       AND pg_get_userbyid(w.datdba) <> '$WORK_OWNER')
      FROM pg_database d WHERE d.datname='$BASELINE'")
if [[ $safe != t ]]; then
    echo "ERROR: baseline absent or protection/ownership checks failed; Work was not modified" >&2
    exit 78
fi

"$PG_BIN/dropdb" "${connection[@]}" --if-exists --force "$WORK_DB"
"$PG_BIN/createdb" "${connection[@]}" --strategy=file_copy \
    --template="$BASELINE" --owner="$WORK_OWNER" "$WORK_DB"
